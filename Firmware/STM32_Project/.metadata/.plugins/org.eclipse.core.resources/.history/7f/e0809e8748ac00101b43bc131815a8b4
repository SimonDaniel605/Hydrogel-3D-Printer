  Stepper_QueueAbs(167.235, 168.249, -98.800, 0.0125, 20.0); // θ=358°

  // Close the loop back to start
  Stepper_QueueAbs(175.000, 170.000, -98.800, 0.0125, 20.0); // close (θ=360°)


  Mosfet_Init();
  HAL_GPIO_WritePin(PELTIER_GPIO_Port, PELTIER_GPIO_Pin, GPIO_PIN_SET); // Give the bed time to cool

  // Start 1µs ticker used by HX711 microDelay()
  HAL_TIM_Base_Start(&htim2);


  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */

  HAL_GPIO_WritePin(SSPORT, SSPIN, GPIO_PIN_SET);

  while (1)
  {
	SystemTasks();
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
  }
  /* USER CODE END 3 */
