// Homing function
void Home(TIM_HandleTypeDef *htim_for_delay){
    const uint32_t pulse_high_us = 5;    // >1 µs is required by A4988 datasheet
    const uint32_t z_between_us  = 150;  // 16 Microsteps + TR8x8 lead screw => 16.13 mm/s
    const uint32_t y_between_us  = 1390; // 16 Microsteps + GT2 36T belt     => 16.13 mm/s
    const uint32_t x_between_us  = 770;  // 16 Microsteps + GT2 20T belt     => 16.13 mm/s

    delay_us_init(htim_for_delay); 						    // pass &htim from main.c
    HAL_GPIO_WritePin(EN_Port, EN_Pin, GPIO_PIN_RESET);     // Enable outputs (LOW = enabled)
    HAL_GPIO_WritePin(SLEEP_Port, SLEEP_Pin, GPIO_PIN_SET); //release reset (HIGH)
    HAL_GPIO_WritePin(RESET_Port, RESET_Pin, GPIO_PIN_SET); //Disable sleep (HIGH)

    // Microstep Settings
    HAL_GPIO_WritePin(M0_Port, M0_Pin, GPIO_PIN_SET);
    HAL_GPIO_WritePin(M1_Port, M1_Pin, GPIO_PIN_SET);
    HAL_GPIO_WritePin(M2_Port, M2_Pin, GPIO_PIN_SET);

    // Homing direction
    HAL_GPIO_WritePin(DIR_Z_Port, DIR_Z_Pin, GPIO_PIN_SET);
    HAL_GPIO_WritePin(DIR_Y_Port, DIR_Y_Pin, GPIO_PIN_SET);
    HAL_GPIO_WritePin(DIR_X_Port, DIR_X_Pin, GPIO_PIN_RESET);

    delay_us(10); // Delay for latency

    //Home Z axis
    while (HAL_GPIO_ReadPin(LIMIT_Z_Port, LIMIT_Z_Pin) == GPIO_PIN_SET) {
        HAL_GPIO_WritePin(STEP_Z_Port, STEP_Z_Pin, GPIO_PIN_SET);
        delay_us(pulse_high_us);
        HAL_GPIO_WritePin(STEP_Z_Port, STEP_Z_Pin, GPIO_PIN_RESET);
        delay_us(z_between_us);
    }

    //Home Y axis
    while (HAL_GPIO_ReadPin(LIMIT_Y_Port, LIMIT_Y_Pin) == GPIO_PIN_SET) {
        HAL_GPIO_WritePin(STEP_Y_Port, STEP_Y_Pin, GPIO_PIN_SET);
        delay_us(pulse_high_us);
        HAL_GPIO_WritePin(STEP_Y_Port, STEP_Y_Pin, GPIO_PIN_RESET);
        delay_us(y_between_us);
    }

    //Home X axis
    while (HAL_GPIO_ReadPin(LIMIT_X_Port, LIMIT_X_Pin) == GPIO_PIN_SET) {
        HAL_GPIO_WritePin(STEP_X_Port, STEP_X_Pin, GPIO_PIN_SET);
        delay_us(pulse_high_us);
        HAL_GPIO_WritePin(STEP_X_Port, STEP_X_Pin, GPIO_PIN_RESET);
        delay_us(x_between_us);
    }
}
static void Task_Once_StorageInit(void)
{
  if (oneTimeDone) return;
  FRESULT fr;

      if (!s_sdReady)
      {
          MX_FATFS_Init();

          HAL_Delay(500); // allow SD card power to stabilize

          fr = f_mount(&s_fs, "", 1);
          USB_Printf("f_mount result = %d\r\n", fr);

          if (fr == FR_OK)
          {
              fr = f_open(&s_file, "PrintTask.csv", FA_READ);

              USB_Printf("f_open result = %d\r\n", fr);

              if (fr == FR_OK)
              {
                  s_sdReady = 1;
                  s_headerSkipped = 0;

                  USB_Printf("SD card ready\r\n");
              }
              else
              {
                  USB_Printf("Failed to open CSV\r\n");
              }
          }
          else
          {
              USB_Printf("Failed to mount SD\r\n");
          }
      }
  oneTimeDone = 1;
}
static void Task_ReadSD(void)
{
  /* Read at 20 Hz */
  uint32_t now = HAL_GetTick();
  if ((now - s_lastSDms) < 50U) return;
  s_lastSDms = now;
  if (!s_sdReady) return;                 // not mounted/opened

  for (int tries = 0; tries < 8; ++tries)  // small chunk per call to stay snappy
  {
    TCHAR* res = f_gets(s_line, sizeof(s_line), &s_file);
    if (!res) {
      /* EOF or read error: stop feeding (or rewind to loop the job) */
      // f_lseek(&s_file, 0);
      // s_headerSkipped = 0;
      return;
    }

    /* Save the FULL line length BEFORE trimming — for correct rewind on queue-full */
    FSIZE_t full_len = (FSIZE_t)strlen(s_line);

    /* Trim leading spaces and optional UTF-8 BOM on the very first line */
    char *p = s_line;
    if (!s_headerSkipped && (unsigned char)p[0]==0xEF && (unsigned char)p[1]==0xBB && (unsigned char)p[2]==0xBF) {
      p += 3; // skip BOM
    }
    while (*p==' ' || *p=='\t') ++p;

    /* Skip blank lines / comments */
    if (*p=='\0' || *p=='\r' || *p=='\n' || *p=='#' || *p==';') continue;

    /* Skip header row once (starts with 'X' or 'x') */
    if (!s_headerSkipped) {
      s_headerSkipped = 1;
      if (p[0]=='X' || p[0]=='x') continue;
    }

    /* Parse CSV: X,Y,Z,Speed,E,Mode,NozzleTemp */
    float X=0, Y=0, Z=0, Speed=0, E=0, NozT=0;
    int   Mode=0;

    int n = sscanf(p, " %f , %f , %f , %f , %f , %d , %f",
                   &X,   &Y,   &Z,   &Speed, &E,   &Mode, &NozT);

    /* Require ALL 7 fields; anything else is malformed => skip safely */
    if (n != 7 || (Mode != 0 && Mode != 1)) {
      continue;
    }

    setNozTempCmd = NozT;  // stash latest temp command

    /* Queue the motion. If queue is full, rewind exactly the full line length. */
    bool ok = (Mode == 0)
      ? Stepper_QueueAbs(X, Y, Z, E, Speed)   // signature: (X,Y,Z,E,Speed)
      : Stepper_QueueRel(X, Y, Z, E, Speed);

    if (!ok) {
      FSIZE_t cur = f_tell(&s_file);
      if (cur >= full_len) {
        f_lseek(&s_file, cur - full_len);  // retry same line next tick
      }
      break;  // stop feeding this cycle
    }
  }
}

static void USB_Printf(const char *fmt, ...)
{
  static char buf[512];
  va_list ap;
  va_start(ap, fmt);
  int n = vsnprintf(buf, sizeof(buf), fmt, ap);
  va_end(ap);
  if (n < 0) return;
  if (n >= (int)sizeof(buf)) n = (int)sizeof(buf) - 1;
  (void)CDC_Transmit_FS((uint8_t*)buf, (uint16_t)n);
}

static void Task_PIDandStreamUSB(void)
{
  uint32_t now = HAL_GetTick();

  if ((now - lastUsbTxMs) >= 1000U)   // 1 Hz PID loop
  {
    float dt = (now - lastUsbTxMs) / 1000.0f;
    if (dt <= 0.0f) dt = 1.0f;

    float temp = MAX6675_ReadTemp();

    if (temp < 0.0f)
    {
      nozDutyCmd = 0.0f;
      pid_integral = 0.0f;
      pid_prevError = 0.0f;
      pid_firstRun = 1;

      USB_Printf("Thermocouple open - heater OFF\r\n");
    }
    else
    {
      tempsC[0] = temp;

      /* If no valid setpoint, keep heater off */
      if (setNozTempCmd <= 0.0f)
      {
        nozDutyCmd = 0.0f;
        pid_integral = 0.0f;
        pid_prevError = 0.0f;
        pid_firstRun = 1;
      }
      else
      {
        float error = setNozTempCmd - temp;

        /* Safety cutoff: too hot */
        if (temp > setNozTempCmd + 20.0f)
        {
          nozDutyCmd = 0.0f;
          pid_integral = 0.0f;
        }
        else
        {
          float derivative = 0.0f;

          if (pid_firstRun)
          {
            derivative = 0.0f;
            pid_prevError = error;
            pid_firstRun = 0;
          }
          else
          {
            derivative = (error - pid_prevError) / dt;
          }

          /* Integral with basic anti-windup */
          pid_integral += error * dt;

          if (pid_integral > 200.0f) pid_integral = 200.0f;
          if (pid_integral < -200.0f) pid_integral = -200.0f;

          float output = (pid_Kp * error)
                       + (pid_Ki * pid_integral)
                       + (pid_Kd * derivative);

          if (output > 100.0f) output = 100.0f;
          if (output < 0.0f)   output = 0.0f;

          nozDutyCmd = output;
          pid_prevError = error;
        }
      }

      USB_Printf("Set=%.2f C, Temp=%.2f C, Duty=%.1f %%\r\n",
                 setNozTempCmd, temp, nozDutyCmd);
    }

    lastUsbTxMs = now;
  }
}

static void Task_UpdatePWMs(void)
{
  uint32_t now = HAL_GetTick();
  if ((now - lastPwmUpdateMs) >= 50U) {
    static uint16_t t = 0;
    t = (uint16_t)((t + 1) % 200);

    /* PB5 (TIM3_CH2): set heater to 50 Hz */
    float dutyA  = nozDutyCmd;

    /* PB6 (TIM4_CH1): turn on fan fully */
    float dutyB  = 100.0f;

    /* PB7 (TIM4_CH2): Curing light protocol */
    float phaseC = (float)t * 2.0f;                  // 0..398 (since t is 0..199)
    if (phaseC > 200.0f) phaseC = 400.0f - phaseC;   // fold to 0..200
    float dutyC  = (phaseC <= 100.0f) ? phaseC : (200.0f - phaseC);


    Mosfet_SetDuty(MOSFET_NOZZLE, dutyA);
    Mosfet_SetDuty(MOSFET_FAN,    dutyB);
    Mosfet_SetDuty(MOSFET_UV,     dutyC);

    lastPwmUpdateMs = now;
  }
}

uint16_t MAX6675_ReadRaw(void)
{
    uint16_t raw_data;

    HAL_GPIO_WritePin(GPIOE, GPIO_PIN_6, GPIO_PIN_RESET);   // CS low
    //HAL_Delay(1);

    HAL_SPI_TransmitReceive(&hspi3, tx_buf, rx_buf, 2, HAL_MAX_DELAY);

    HAL_GPIO_WritePin(GPIOE, GPIO_PIN_6, GPIO_PIN_SET);     // CS high

    raw_data = (rx_buf[0] << 8) | rx_buf[1];

    return raw_data;
}

float MAX6675_ReadTemp(void)
{
    uint16_t raw = MAX6675_ReadRaw();

    if (raw & 0x0004)   // thermocouple open
    {
        return -1.0f;
    }

    raw >>= 3;          // remove lower 3 bits

    return raw * 0.25f;
}

