  HAL_GPIO_WritePin(PELTIER_GPIO_Port, PELTIER_GPIO_Pin, GPIO_PIN_SET); // Give the bed time to cool


  extern TIM_HandleTypeDef htim5;
  Home(&htim5);

  // Start the stepper ISR scheduler on TIM1
  Stepper_Init_TIM1();
  Stepper_ResetPosition(0,0,0,0);
  Stepper_QueueAbs(135, 170.5, -99.7, 0, 30 );// The iteratively solved bed center
  Stepper_QueueAbs(135, 190.5, -99.3, 0, 30 );// The iteratively solved bed center
  //Stepper_QueueAbs(210, 270, -90, 0, 40 );
  //Stepper_QueueAbs(210, 270, -90, 10, 2 );
  //Stepper_QueueAbs(210,0,0,31,40);

  Mosfet_Init();
  HAL_GPIO_WritePin(PELTIER_GPIO_Port, PELTIER_GPIO_Pin, GPIO_PIN_SET); // Give the bed time to cool
  HAL_TIM_Base_Start(&htim2);
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  //HAL_GPIO_WritePin(SSPORT, SSPIN, GPIO_PIN_SET);
  while (1)
  {
	SystemTasks();
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
  }
  /* USER CODE END 3 */
}

